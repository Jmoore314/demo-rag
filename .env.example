# Copy this file to .env and fill in your own values. .env is gitignored --
# never commit real keys or connection strings.

# Voyage AI API key (embeddings). Get one at https://www.voyageai.com/
VOYAGE_API_KEY=

# Anthropic API key (generation). Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Postgres connection string for your Supabase project (or any Postgres
# instance with the pgvector extension enabled). See schema.sql.
SUPABASE_DB_URL=postgresql://user:password@host:5432/postgres

# Local path to your own PDF -- kept out of tracked code on purpose. See
# "What's intentionally not in this repo" in README.md.
SOURCE_PDF_PATH=path/to/your-document.pdf
